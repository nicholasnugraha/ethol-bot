# ===== Telegram =====
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chat ID kamu (boleh lebih dari satu, pisahkan koma). Bot menolak semua ID lain.
# Cek ID lewat @userinfobot.
ALLOWED_CHAT_IDS=123456789

# ===== Keamanan =====
# Generate sekali:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Jangan ganti setelah bot dipakai, atau sesi tersimpan tidak bisa didekripsi.
ENCRYPTION_KEY=ganti-dengan-fernet-key-32-byte-base64

# Password untuk noVNC. Wajib diisi.
# Catatan: protokol VNC efektif membatasi password ~8 karakter. Gunakan 8
# karakter acak, lalu lindungi port 6080 dengan firewall/TLS (lihat README).
VNC_PASSWORD=xxxxxxxx

# URL noVNC yang bisa dibuka dari HP/laptop.
# Ganti YOUR_VPS_IP dengan IP publik atau domain VPS.
NOVNC_PUBLIC_URL=http://YOUR_VPS_IP:6080/vnc.html?autoconnect=1&resize=scale&reconnect=1

# ===== ETHOL =====
ETHOL_BASE_URL=https://ethol.pens.ac.id
CAS_LOGIN_URL=https://login.pens.ac.id/cas/login?service=https%3A%2F%2Fethol.pens.ac.id%2Fapi%2Fauth%2Fcas-callback

# ===== Perilaku bot =====
TIMEZONE=Asia/Jakarta
POLL_INTERVAL_SECONDS=45
WINDOW_BEFORE_MINUTES=10
WINDOW_AFTER_MINUTES=10
# confirm = bot minta kamu tekan Hadir/Izin/Sakit
# auto    = bot langsung mengirim presensi saat sesi dibuka (gunakan dengan sadar)
ATTENDANCE_MODE=confirm
DAILY_SUMMARY_TIME=06:30
SESSION_CHECK_SECONDS=600
LOGIN_TIMEOUT_SECONDS=300
KEEP_BROWSER_OPEN=false

# ===== Penyimpanan =====
DB_PATH=/data/app.db
BROWSER_PROFILE_DIR=/data/browser-profile
LOG_LEVEL=INFO
